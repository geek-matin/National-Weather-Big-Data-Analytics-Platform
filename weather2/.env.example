# ==============================================================================
# National Weather Big Data Analytics Platform (MoES / IMD - SIH 2026)
# Environment Configuration
# ==============================================================================

# Application Environment (development | production)
ENV=development
API_PORT=8000
API_HOST=0.0.0.0

# Database Configuration
# Default uses local SQLite with spatial query support for zero-friction setup.
# In Docker or production, set to PostgreSQL with PostGIS:
# DATABASE_URL=postgresql+psycopg2://imd_admin:imd_secure_pass_2026@localhost:5432/weather_analytics
DATABASE_URL=sqlite:///./weather.db

# Message Bus (Kafka / Redpanda)
# If left blank or unreachable, platform automatically uses async in-memory bus
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=raw-weather-events

# Ingestion APIs (Optional - platform includes synthetic generator + mock fallback)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=imd_weather_monitor:v1.0.0

# Storage
MEDIA_STORAGE_DIR=./media
